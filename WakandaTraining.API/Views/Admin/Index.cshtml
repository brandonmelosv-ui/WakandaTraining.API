@model IEnumerable<WakandaTraining.API.Models.Curso>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Painel Administrativo - Wakanda Training</title>

    <style>
            body {
                font-family: Arial, sans-serif;
                background: #f2f4f1;
                margin: 0;
                padding: 30px;
                color: #263522;
            }

            main {
                max-width: 900px;
                margin: auto;
                background: white;
                padding: 24px;
                border-radius: 12px;
            }

            h1 {
                margin-top: 0;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th, td {
                padding: 12px;
                border-bottom: 1px solid #ddd;
                text-align: left;
            }

            th {
                background: #263522;
                color: white;
            }
    </style>
</head>
<body>
    <main>
        <h1>Wakanda Training</h1>
        <h2>Painel Administrativo</h2>

        <p>Cursos cadastrados no sistema: @Model.Count()</p>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Curso</th>
                    <th>Carga horária</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var curso in Model)
                {
                    <tr>
                        <td>@curso.Id</td>
                        <td>@curso.Nome</td>
                        <td>@curso.CargaHoraria horas</td>
                        <td>@(curso.Concluido ? "Concluído" : "Pendente")</td>
                    </tr>
                }
            </tbody>
        </table>
    </main>
</body>
</html>
